   "core": "You take 15% less from super-effective hits and counter any super-effective hit for 6% of your max HP.",
   "clutch": "A lethal hit leaves you at 1 HP.",
   "drawback": "Your Speed is 15% lower."
  },
  {
   "id": "last_gamble",
   "pulse": "KO",
   "core": "Item rewards +15%.",
   "clutch": "A lethal hit leaves you at 30% HP and your next 2 moves deal 30% more.",
   "drawback": "After the clutch fires you take 25% more damage for the rest of the battle."
  },
  {
   "id": "miasma_front",
   "pulse": "TICK",
   "core": "While any weather is active every foe takes 2.5% of max HP each turn, rising 1% a turn to 5%; poison you inflict +20%.",
   "clutch": "",
