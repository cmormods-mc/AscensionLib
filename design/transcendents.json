 "signatures": [
  {
   "id": "phoenix_cinder",
   "pulse": "STRUCK",
   "core": "Attackers that hit you while you are below 50% HP are burned.",
   "clutch": "A lethal hit leaves you at 20% HP instead of fainting.",
   "drawback": "Healing cannot raise you above 70% of max HP."
  },
  {
   "id": "plague_pyre",
   "pulse": "TICK",
   "core": "Burned or poisoned foes take an extra 3% of max HP each turn.",
   "clutch": "",
   "drawback": "Your direct damage is 10% lower."
  },
  {
   "id": "wildfire_crown",
   "pulse": "HIT",
   "core": "Fire moves deal 20% more; while any weather is active all your moves deal 10% more.",
   "clutch": "",
   "drawback": "Water and Ice moves deal 25% less."
  },
  {
   "id": "brand_of_ruin",
   "pulse": "HIT",
   "core": "A damaging hit Brands the foe for 3 turns: it takes 10% more from you and 30% more from burn and bleed.",
   "clutch": "",
   "drawback": "A new Brand costs you 3% of max HP."
  },
  {
   "id": "titans_forge",
   "pulse": "HIT",
   "core": "A super-effective hit adds 8% of your max HP in damage and has a 25% chance to burn.",
   "clutch": "",
   "drawback": "You lose 3% of max HP each turn while above 60% HP."
  },
  {
   "id": "gilded_ember",
   "pulse": "KO",
   "core": "Burn damage you inflict +30%; each KO adds +10% damage (3 stacks, lost on switching out); item rewards +10%.",
   "clutch": "",
   "drawback": "You take 15% more damage from Water moves."
  },
  {
   "id": "dying_bloom",
   "pulse": "STRUCK",
   "core": "Attackers that hit you while you are below 50% HP are poisoned; your poison ramps twice as fast then.",
   "clutch": "A lethal hit leaves you at 1 HP.",
   "drawback": "Healing you receive is 35% lower."
  },
  {
   "id": "eye_of_the_storm",
   "pulse": "TICK",
   "core": "While any weather is active, heal 3% of max HP each turn and take 12% less damage.",
   "clutch": "A lethal hit leaves you at 1 HP.",
   "drawback": "With no weather you take 12% more damage."
  },
  {
   "id": "martyrs_edge",
   "pulse": "HIT",
   "core": "Physical hits bleed; you deal 12% more to bleeding foes.",
   "clutch": "A lethal hit leaves you at 1 HP and your next hit is a guaranteed critical.",
   "drawback": "Your bleeds are weaker (stack weights 1, 0.8, 0.6)."
