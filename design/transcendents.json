  },
  {
   "id": "festering_gash",
   "pulse": "HIT",
   "core": "Physical hits bleed; each turn a foe bleeds its bleed damage rises 15% (to 60%); you heal 25% of the bleed damage dealt.",
   "clutch": "",
   "drawback": "You take 20% more damage from Psychic moves."
